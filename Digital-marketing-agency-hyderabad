<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --teal:#00C2CB;
  --teal-dim:rgba(0,194,203,.12);
  --teal-glow:rgba(0,194,203,.06);
  --gold:#F4A100;
  --navy:#04090f;
  --surface:#050d18;
  --white:#f5f5f7;
  --muted:rgba(245,245,247,.42);
  --faint:rgba(245,245,247,.18);
  --line:rgba(255,255,255,.07);
  --nh:64px;
  --radius:14px;
}
html{scroll-behavior:smooth}
body{background:var(--navy);color:var(--white);font-family:'Inter',sans-serif;overflow-x:hidden;cursor:none}

/* CUSTOM CURSOR */
#c1{position:fixed;width:7px;height:7px;background:var(--teal);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:difference;transition:width .2s,height .2s}
#c2{position:fixed;width:30px;height:30px;border:1px solid rgba(0,194,203,.3);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .3s,height .3s,border-color .3s}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:600;height:var(--nh);padding:0 5vw;display:flex;align-items:center;justify-content:space-between;background:rgba(4,9,15,.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--line);transition:background .4s}
nav.scrolled{background:rgba(4,9,15,.98)}
.n-logo{display:flex;align-items:center;gap:9px;text-decoration:none;flex-shrink:0}
.n-logo img{height:28px;width:auto;display:block}
.n-brand{font-size:.95rem;font-weight:700;letter-spacing:-.2px;color:var(--white)}
.n-brand em{color:var(--teal);font-style:normal}
.n-links{display:flex;gap:28px;list-style:none;align-items:center;position:absolute;left:50%;transform:translateX(-50%)}
.n-links a{font-size:.75rem;color:var(--muted);text-decoration:none;transition:color .2s;font-weight:500;white-space:nowrap}
.n-links a:hover,.n-links a.active{color:var(--white)}
.n-links a.active{color:var(--teal)}
.n-right{display:flex;align-items:center;gap:14px;flex-shrink:0}
.n-cta{font-size:.74rem;font-weight:600;color:var(--teal);border:1px solid rgba(0,194,203,.3);padding:7px 18px;border-radius:980px;text-decoration:none;transition:all .25s;white-space:nowrap}
.n-cta:hover{background:var(--teal);color:var(--navy)}
.n-breadcrumb{font-size:.65rem;color:var(--faint);display:flex;align-items:center;gap:6px;padding:4px 12px;background:rgba(0,194,203,.06);border:1px solid rgba(0,194,203,.12);border-radius:980px;white-space:nowrap}
.n-breadcrumb a{color:var(--teal);text-decoration:none}
.n-breadcrumb span{color:var(--faint)}

/* HAMBURGER */
.ham{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;background:none;border:none}
.ham span{display:block;width:22px;height:1.5px;background:var(--white);transition:all .35s;transform-origin:center}
.ham.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham.open span:nth-child(2){opacity:0;transform:scaleX(0)}
.ham.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
#mmenu{position:fixed;inset:0;background:rgba(4,9,15,.97);backdrop-filter:blur(28px);z-index:590;display:none;flex-direction:column;align-items:center;justify-content:center;gap:36px;opacity:0;pointer-events:none;transition:opacity .4s}
#mmenu.open{display:flex;opacity:1;pointer-events:auto}
#mmenu a{font-size:1.8rem;font-weight:700;color:var(--muted);text-decoration:none;transition:color .2s;letter-spacing:-.5px}
#mmenu a:hover{color:var(--white)}
#mmenu .mm-cta{font-size:1.1rem;color:var(--teal);border:1px solid rgba(0,194,203,.3);padding:14px 36px;border-radius:980px}

/* HERO */
#hero{position:relative;min-height:92vh;padding-top:var(--nh);display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--navy)}
.hero-glow{position:absolute;width:900px;height:900px;background:radial-gradient(circle,rgba(0,194,203,.055) 0%,transparent 65%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(0,194,203,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,194,203,.025) 1px,transparent 1px);background-size:55px 55px;mask-image:radial-gradient(ellipse 80% 70% at 50% 50%,black 10%,transparent 100%);pointer-events:none}
.hero-c{position:relative;z-index:2;text-align:center;padding:60px 6vw 80px;max-width:1000px;width:100%}
.hero-location-pill{display:inline-flex;align-items:center;gap:8px;font-size:.62rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--teal);background:rgba(0,194,203,.07);border:1px solid rgba(0,194,203,.18);padding:8px 18px;border-radius:980px;margin-bottom:28px}
h1.hero-h1{font-size:clamp(2.6rem,6.5vw,5.4rem);font-weight:800;line-height:1.04;letter-spacing:-2.5px;margin-bottom:22px;color:var(--white)}
h1.hero-h1 .tc{color:var(--teal)}
h1.hero-h1 .line{display:block;overflow:hidden}
h1.hero-h1 .line span{display:block;transform:translateY(110%);transition:transform .9s cubic-bezier(.16,1,.3,1)}
.hero-sub{font-size:1rem;color:var(--muted);line-height:1.8;font-weight:300;max-width:640px;margin:0 auto 40px;opacity:0;transform:translateY(16px);transition:opacity .8s .5s,transform .8s .5s}
.hero-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;opacity:0;transform:translateY(16px);transition:opacity .7s .7s,transform .7s .7s}
.btn-p{background:var(--teal);color:var(--navy);padding:13px 28px;border-radius:980px;font-weight:700;font-size:.86rem;text-decoration:none;transition:all .3s;display:inline-flex;align-items:center;gap:7px}
.btn-p:hover{transform:scale(1.04);box-shadow:0 0 40px rgba(0,194,203,.4)}
.btn-s{background:rgba(255,255,255,.06);color:rgba(255,255,255,.65);padding:13px 28px;border-radius:980px;font-weight:500;font-size:.86rem;text-decoration:none;transition:all .3s;border:1px solid rgba(255,255,255,.1)}
.btn-s:hover{background:rgba(255,255,255,.1);color:var(--white)}
.hero-trust{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:36px;flex-wrap:wrap;opacity:0;transition:opacity .7s .9s}
.trust-item{display:flex;align-items:center;gap:7px;font-size:.72rem;color:var(--faint)}
.trust-dot{width:5px;height:5px;border-radius:50%;background:var(--teal)}

/* TICKER */
.ticker{background:var(--teal);padding:10px 0;overflow:hidden}
.t-inner{display:inline-flex;animation:tick 40s linear infinite;white-space:nowrap}
.t-item{font-size:.65rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--navy);padding:0 20px}
.t-item::after{content:' ✦ ';margin-left:20px}
@keyframes tick{to{transform:translateX(-50%)}}

/* SHARED */
.sec-label{font-size:.62rem;font-weight:700;letter-spacing:3.5px;text-transform:uppercase;color:var(--teal);display:flex;align-items:center;gap:10px;margin-bottom:12px}
.sec-label::before,.sec-label::after{content:'';width:20px;height:1px;background:var(--teal)}
.sec-label.c{justify-content:center}
.sec-label.l{justify-content:flex-start}
.rv{opacity:0;transform:translateY(36px);transition:opacity .75s ease,transform .75s ease}
.rv.on{opacity:1;transform:translateY(0)}
.sec-h2{font-size:clamp(2rem,4.5vw,3.4rem);font-weight:800;line-height:1.1;letter-spacing:-1.5px;color:var(--white)}
.sec-h2 em{color:var(--teal);font-style:normal}
.sec-p{font-size:1rem;color:var(--muted);line-height:1.8;font-weight:300;max-width:580px;margin:16px auto 0}

/* AREAS SERVED STRIP */
#areas{background:var(--surface);padding:48px 5vw;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.areas-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;gap:24px;flex-wrap:wrap}
.areas-label{font-size:.62rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--teal);white-space:nowrap;flex-shrink:0}
.areas-pills{display:flex;flex-wrap:wrap;gap:8px}
.area-pill{font-size:.72rem;font-weight:500;color:var(--muted);background:rgba(0,194,203,.05);border:1px solid rgba(0,194,203,.12);padding:5px 14px;border-radius:980px;text-decoration:none;transition:all .25s;white-space:nowrap}
.area-pill:hover{color:var(--teal);border-color:rgba(0,194,203,.3);background:rgba(0,194,203,.08)}

/* MAIN SERVICES GRID */
#services-main{background:var(--navy);padding:100px 5vw}
.srv-head{text-align:center;margin-bottom:64px}
.services-list{display:flex;flex-direction:column;gap:1px;max-width:1100px;margin:0 auto;border:1px solid var(--line);border-radius:20px;overflow:hidden}
.srv-row{display:grid;grid-template-columns:80px 1fr auto;gap:28px;align-items:start;padding:36px 40px;background:var(--surface);border-bottom:1px solid var(--line);text-decoration:none;position:relative;overflow:hidden;transition:background .3s}
.srv-row:last-child{border-bottom:none}
.srv-row::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(to bottom,var(--teal),rgba(0,194,203,.2));transform:scaleY(0);transition:transform .4s;transform-origin:top}
.srv-row:hover{background:rgba(0,194,203,.025)}
.srv-row:hover::before{transform:scaleY(1)}
.srv-row-icon{font-size:2.4rem;line-height:1;padding-top:4px}
.srv-row-body{flex:1}
.srv-row-body h2{font-size:1.15rem;font-weight:700;color:var(--white);margin-bottom:8px;line-height:1.25}
.srv-row-body p{font-size:.84rem;color:var(--muted);line-height:1.75;font-weight:300;max-width:560px}
.srv-row-body .srv-kws{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.srv-kw{font-size:.6rem;font-weight:600;color:rgba(0,194,203,.7);background:rgba(0,194,203,.06);border:1px solid rgba(0,194,203,.12);padding:3px 10px;border-radius:100px;letter-spacing:.3px}
.srv-row-meta{display:flex;flex-direction:column;align-items:flex-end;gap:10px;flex-shrink:0;min-width:140px}
.srv-price{font-size:.72rem;color:var(--muted);font-weight:400;text-align:right}
.srv-price strong{font-size:.88rem;color:var(--white);font-weight:700;display:block;margin-bottom:2px}
.srv-cta-link{font-size:.72rem;font-weight:700;color:var(--teal);display:inline-flex;align-items:center;gap:5px;padding:7px 16px;border:1px solid rgba(0,194,203,.25);border-radius:980px;transition:all .3s;white-space:nowrap}
.srv-row:hover .srv-cta-link{background:var(--teal);color:var(--navy)}

/* AREAS DEEP-DIVE */
#local-areas{background:var(--surface);padding:100px 5vw}
.local-head{text-align:center;margin-bottom:56px}
.local-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:1100px;margin:0 auto}
.local-card{background:rgba(255,255,255,.025);border:1px solid var(--line);border-radius:var(--radius);padding:28px 24px;transition:all .35s;position:relative;overflow:hidden}
